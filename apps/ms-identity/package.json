{
  "name": "@cka/ms-identity",
  "version": "0.1.0",
  "private": true,
  "description": "Identity service: users, roles, invitations, sessions, password reset, token signing (JWKS).",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "cli": "node dist/cli.js",
    "cli:dev": "nest build && node dist/cli.js",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cka/auth-kit": "0.1.0",
    "@cka/contracts": "0.1.0",
    "@cka/service-kit": "0.1.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
