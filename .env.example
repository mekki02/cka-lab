# Docker Compose configuration. Copy to `.env` (git-ignored) and change every
# value marked CHANGE ME. `npm run keys:generate` fills JWT_PRIVATE_KEY for you.
#
# Full reference of every variable: docs/CONFIGURATION.md

# --- Public entry point -------------------------------------------------------
# Port the edge proxy listens on, on your machine.
EDGE_PORT=8080
# URL people type in their browser. Used to build invitation / reset links.
PUBLIC_URL=http://localhost:8080
# Cookies are Secure (HTTPS-only) by default. Plain-HTTP localhost is the one
# place to turn that off. Keep "true" anywhere reachable from a network.
COOKIE_SECURE=false

# --- PostgreSQL ---------------------------------------------------------------
# Superuser of the bundled Postgres; only used to create the service databases.
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
# One login role per service (created by deploy/compose/postgres-init).
IDENTITY_DB_PASSWORD=CHANGE_ME_identity
LEARNING_DB_PASSWORD=CHANGE_ME_learning
# Host port for connecting with psql / running services outside Docker.
POSTGRES_PORT=5433

# --- Tokens -------------------------------------------------------------------
# Ed25519 private key (PKCS#8 PEM, newlines as \n). Generate: npm run keys:generate
JWT_PRIVATE_KEY=
JWT_KEY_ID=key-1

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
